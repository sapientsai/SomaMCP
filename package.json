{
  "name": "somamcp",
  "version": "2.4.0",
  "description": "Framework for building MCP servers with telemetry, introspection, and backend abstraction",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js",
      "default": "./dist/backend/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "eslint ./src --fix --max-warnings=0",
    "lint:check": "eslint ./src --max-warnings=0",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build && pnpm check:bundle",
    "dev": "ts-builds dev",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm validate && pnpm check:bundle",
    "check:bundle": "node scripts/check-worker-bundle.mjs"
  },
  "keywords": [
    "MCP",
    "server",
    "telemetry",
    "introspection",
    "backend-adapter"
  ],
  "author": "Jordan Burke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/SomaMCP.git"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/SomaMCP/issues"
  },
  "homepage": "https://github.com/sapientsai/SomaMCP#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "~2.4.0",
    "@modelcontextprotocol/server": "~2.4.0",
    "functype": "^1.21.1",
    "functype-log": "^1.21.1",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "prettier": "ts-builds/prettier",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.19.2",
    "es-module-lexer": "^3.0.4",
    "esbuild": "^0.28.2",
    "get-port-please": "^3.2.0",
    "miniflare": "^4.20260730.0",
    "ts-builds": "^4.0.2",
    "tsdown": "^0.23.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
