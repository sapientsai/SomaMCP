{
  "name": "somamcp",
  "version": "1.0.15",
  "description": "Framework for building MCP servers with telemetry, introspection, and backend abstraction",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "eslint ./src --fix --max-warnings=0",
    "lint:check": "eslint ./src --max-warnings=0",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm validate"
  },
  "keywords": [
    "MCP",
    "server",
    "telemetry",
    "introspection",
    "backend-adapter"
  ],
  "author": "Jordan Burke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/SomaMCP.git"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/SomaMCP/issues"
  },
  "homepage": "https://github.com/sapientsai/SomaMCP#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastmcp": "^4.3.0",
    "functype": "^1.4.4",
    "functype-log": "^1.4.4",
    "hono": "^4.12.26",
    "zod": "^4.4.3"
  },
  "prettier": "ts-builds/prettier",
  "devDependencies": {
    "@types/node": "^24.13.2",
    "get-port-please": "^3.2.0",
    "ts-builds": "^3.2.1",
    "tsdown": "^0.22.3"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
