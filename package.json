{
  "name": "somamcp",
  "version": "1.0.12",
  "description": "Framework for building MCP servers with telemetry, introspection, and backend abstraction",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm validate"
  },
  "keywords": [
    "MCP",
    "server",
    "telemetry",
    "introspection",
    "backend-adapter"
  ],
  "author": "Jordan Burke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/SomaMCP.git"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/SomaMCP/issues"
  },
  "homepage": "https://github.com/sapientsai/SomaMCP#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastmcp": "^4.1.0",
    "functype": "^1.4.1",
    "functype-log": "^1.4.1",
    "hono": "^4.12.25",
    "zod": "^4.4.3"
  },
  "prettier": "ts-builds/prettier",
  "devDependencies": {
    "@types/node": "^24.13.2",
    "get-port-please": "^3.2.0",
    "ts-builds": "^3.1.1",
    "tsdown": "^0.22.2"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
