{
  "name": "somamcp",
  "version": "1.0.12",
  "description": "Framework for building MCP servers with telemetry, introspection, and backend abstraction",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm validate"
  },
  "keywords": [
    "MCP",
    "server",
    "telemetry",
    "introspection",
    "backend-adapter"
  ],
  "author": "Jordan Burke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/SomaMCP.git"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/SomaMCP/issues"
  },
  "homepage": "https://github.com/sapientsai/SomaMCP#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastmcp": "^4.0.1",
    "functype": "^1.3.0",
    "functype-log": "^1.3.0",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "prettier": "ts-builds/prettier",
  "devDependencies": {
    "@types/node": "^24.12.4",
    "get-port-please": "^3.2.0",
    "ts-builds": "^3.0.0",
    "tsdown": "^0.22.1"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
