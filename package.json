{
  "name": "somamcp",
  "version": "1.5.0",
  "description": "Framework for building MCP servers with telemetry, introspection, and backend abstraction",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "eslint ./src --fix --max-warnings=0",
    "lint:check": "eslint ./src --max-warnings=0",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build && pnpm check:edge",
    "check:edge": "node scripts/check-edge-bundle.mjs",
    "dev": "ts-builds dev",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm validate && pnpm check:edge"
  },
  "keywords": [
    "MCP",
    "server",
    "telemetry",
    "introspection",
    "backend-adapter"
  ],
  "author": "Jordan Burke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/SomaMCP.git"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/SomaMCP/issues"
  },
  "homepage": "https://github.com/sapientsai/SomaMCP#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "~2.3.1",
    "fastmcp": "^4.22.10",
    "functype": "^1.18.0",
    "functype-log": "^1.18.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "prettier": "ts-builds/prettier",
  "devDependencies": {
    "@modelcontextprotocol/client": "~2.3.1",
    "@types/node": "^24.19.2",
    "get-port-please": "^3.2.0",
    "ts-builds": "^4.0.0",
    "tsdown": "^0.22.14"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024"
}
