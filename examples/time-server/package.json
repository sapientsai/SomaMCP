{
  "name": "@somamcp-examples/time-server",
  "version": "0.0.0",
  "private": true,
  "description": "Sample MCP time server used as a testbed for somamcp",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "somamcp": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
